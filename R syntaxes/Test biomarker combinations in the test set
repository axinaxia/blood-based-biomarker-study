# 1. Create variables for biomarker combinations ----
#--------------------------------------------------------------------------------------------------------------------------#
# (1) Define abnormal level for each biomarker
# (2) Generate the number of biomarkers with abnormal levels in ptau217, GFAP, and NfL
# (2) Generate three combinations for ptau217, GFAP, and NfL:
# ptau217+GFAP, ptau217+NfL, GFAP+NfL
#--------------------------------------------------------------------------------------------------------------------------#

# first generate these variables for all-cause dementia
dataset_dem10<-dataset_dem10 %>% 
  mutate(abetaratio_pos_dem=as.numeric(abetaratio<=
                                      (cutoff_10yr %>% 
                                         filter(marker=="abetaratio"&
                                                  outcome=="Dementia"))$cp), # abnormal ab ratio
         ptau181_pos_dem=as.numeric(ptau181>=
                                   (cutoff_10yr %>% 
                                      filter(marker=="ptau181"&
                                               outcome=="Dementia"))$cp), # elevated ptau181
         ttau_pos_dem=as.numeric(ttau>=
                                      (cutoff_10yr %>% 
                                         filter(marker=="ttau"&
                                                  outcome=="Dementia"))$cp), # elevated ttau
         ptau217_pos_dem=as.numeric(ptau217>=
                                      (cutoff_10yr %>% 
                                         filter(marker=="ptau217"&
                                                  outcome=="Dementia"))$cp), # elevated ptau217
         nfl_pos_dem=as.numeric(nfl>=
                                      (cutoff_10yr %>% 
                                         filter(marker=="nfl"&
                                                  outcome=="Dementia"))$cp), # elevated nfl
         gfap_pos_dem=as.numeric(gfap>=
                                  (cutoff_10yr %>% 
                                     filter(marker=="gfap"&
                                              outcome=="Dementia"))$cp), # elevated gfap
)

dataset_dem10<-dataset_dem10 %>%
  mutate(no_posbio_dem=ptau217_pos_dem+nfl_pos_dem+gfap_pos_dem, # number of abnormal biomarkers among ptau217, gfap, and nfl
         posbio1_dem=case_when(no_posbio_dem==0~0,
                               no_posbio_dem==1~1,
                               T~NA), # 0 = all three biomarkers have normal levels, 1 = one biomarker has abnormal level
         posbio2_dem=case_when(no_posbio_dem==0~0,
                               no_posbio_dem==2~1,
                               T~NA), # 0 = all three biomarkers have normal levels, 1 = two biomarkers have abnormal level
         posbio3_dem=case_when(no_posbio_dem==0~0,
                               no_posbio_dem==3~1,
                               T~NA), # 0 = all three biomarkers have normal levels, 1 = three biomarkers have abnormal level
         ptau217_nfl_dem=ifelse(ptau217_pos_dem==1&nfl_pos_dem==1,1,0), # elevated ptau217+nfl
         ptau217_gfap_dem=ifelse(ptau217_pos_dem==1&gfap_pos_dem==1,1,0), # elevated ptau217+gfap
         nfl_gfap_dem=ifelse(nfl_pos_dem==1&gfap_pos_dem==1,1,0) # elevated gfap+nfl
)

dataset_dem10<-dataset_dem10 %>% 
  select(Lopnr,ends_with("pos_dem"),
         posbio1_dem,posbio2_dem,posbio3_dem,
         ptau217_nfl_dem,ptau217_gfap_dem,nfl_gfap_dem,dem10)
  

