roc_data_single<-table_sum %>% 
  filter(marker %in% c("abetaratio","ptau181",
                       "ptau217","ttau","nfl","gfap")) %>% 
  select(marker,outcome,sens,spe) 

roc_data_single<-roc_data_single %>% 
  rbind(roc_data_single %>% 
          mutate(sens=0,
                 spe=1)) %>% # generate the lower endpoint of the diagonal line on the ROC curve
  rbind(roc_data_single %>% 
          mutate(sens=1,
                 spe=0)) %>% # generate the upper endpoint of the diagonal line on the ROC curve 
  mutate(marker=factor(marker,levels=c("abetaratio","ptau181",
                                       "ptau217","ttau","nfl","gfap"),
                       labels=c("Aβ42/Aβ40 ratio","P-tau181",
                                "P-tau217","T-tau","NfL","GFAP")))

